# GitHub Copilot token — richiesto con abbonamento Copilot attivo
# Token types supportati: gho_ (OAuth), github_pat_ (fine-grained PAT)
COPILOT_GITHUB_TOKEN=your_github_token_here

# Server Configuration (usato da api/server.js)
PORT=3001
NODE_ENV=development

# Chiavi alternative (decommentare se si cambia provider in config.json)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here